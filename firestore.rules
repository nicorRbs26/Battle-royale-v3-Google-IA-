rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Helper to check if a user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper to check if the caller is the owner of the document
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Players Stats
    match /players_stats/{userId} {
      allow read: if true; // Everyone can read player stats for leaderboards or spec
      allow write, update: if isOwner(userId);
    }

    // Match History
    match /match_history/{matchId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // Leaderboards
    match /leaderboards/{userId} {
      allow read: if true;
      allow write, update: if isOwner(userId);
    }
  }
}
